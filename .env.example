# PORT: puerto del servidor Express (por defecto 3000).
PORT=3000

# GEMINI_API_KEY: opcional. El proyecto no llama a Gemini en el código actual;
# se deja por compatibilidad con el entorno original de AI Studio.
# GEMINI_API_KEY=

# APP_URL: URL pública si se despliega (enlaces de recordatorio WhatsApp usan origin del navegador).
# APP_URL=http://localhost:3000
