# Copy this file to .env for local development (never commit the real .env).

# Database connection string. Local dev uses SQLite (no setup required):
DATABASE_URL="file:./dev.db"
# Production points this at a hosted PostgreSQL instance instead, e.g.:
# DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
# (and set `provider = "postgresql"` in prisma/schema.prisma — see README "Deploy")

# Random secret used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="MY_SESSION_SECRET"

# bcrypt hash of the shared clinic password (never store the plaintext
# password anywhere). Generate it with:
#   npm run hash-password -- "la-contraseña-del-consultorio"
AUTH_PASSWORD_HASH="MY_AUTH_PASSWORD_HASH"

# Shared secret required to call the /api/test/reset endpoint used by the
# E2E test suite. That endpoint only exists outside NODE_ENV=production
# regardless of this value — set to any random string for local dev/CI.
TEST_RESET_TOKEN="MY_TEST_RESET_TOKEN"

# Optional: port the server listens on (defaults to 3000).
# PORT=3000

# Optional: max /api/auth/login attempts per IP per 15 minutes (defaults to
# 8 — a strict production default meant to blunt brute-forcing the single
# shared password). The Playwright config raises this for local/CI test runs.
# LOGIN_RATE_LIMIT=8

# Optional: lets "Limpiar Turnos Cancelados" write "CANCELADO" back into the
# Google Sheets cell a turno came from, instead of only deleting it locally.
# Without this set, cleanup still works — it just doesn't touch the sheet.
# Paste the FULL content of the service account JSON key file (see
# DEPLOY.md "Sincronizar cancelaciones a Google Sheets") as one single-line
# string.
# GOOGLE_SHEETS_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}'
